[Unit]
Description=LazyingArt production Weiqi teaching API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=lachlan
Group=lachlan
WorkingDirectory=/home/lachlan/.local/share/lazying-game/current/weiqi
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
EnvironmentFile=/home/lachlan/.config/lazying-game/gpu1.env
Environment=WEIQI_HOST=127.0.0.1
Environment=WEIQI_PORT=8010
Environment=WEIQI_DATA_DIR=/home/lachlan/.local/share/lazying-game/data/weiqi
Environment=WEIQI_OPENAI_API_KEY=
Environment=WEIQI_LOCALLLM_ENABLED=false
Environment=WEIQI_LOCALLLM_PROSE_COACHING_ENABLED=false
Environment=WEIQI_KATAGO_ENABLED=true
Environment=WEIQI_KATAGO_GPU=1
Environment=WEIQI_KATAGO19_ENABLED=true
Environment=WEIQI_KATAGO19_GPU=1
ExecStartPre=/home/lachlan/.local/share/lazying-game/current/ops/assert-gpu1.sh
ExecStart=/home/lachlan/.local/share/lazying-game/current/weiqi/apps/api/.venv/bin/python -m uvicorn weiqi.main:app --app-dir /home/lachlan/.local/share/lazying-game/current/weiqi/apps/api --host 127.0.0.1 --port 8010 --workers 1
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillMode=control-group
MemoryHigh=6G
MemoryMax=10G
CPUQuota=800%
TasksMax=256
LimitNOFILE=8192
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/lachlan/.local/share/lazying-game/data/weiqi /home/lachlan/.local/state/lazying-game/katago /home/lachlan/.local/state/lazying-game/katago19
BindPaths=/home/lachlan/.local/state/lazying-game/katago:/home/lachlan/.local/share/lazying-game/current/weiqi/.local/runtime/katago
BindPaths=/home/lachlan/.local/state/lazying-game/katago19:/home/lachlan/.local/share/lazying-game/current/weiqi/.local/runtime/katago19

[Install]
WantedBy=multi-user.target
