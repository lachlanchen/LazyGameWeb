[Unit]
Description=LazyingArt strict local game API gateway
Wants=network-online.target lazying-game-weiqi.service lazying-game-douzero.service
After=network-online.target lazying-game-weiqi.service lazying-game-douzero.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=lachlan
Group=lachlan
WorkingDirectory=/home/lachlan/.local/share/lazying-game/current
Environment=GAME_GATEWAY_PORT=18030
Environment=GAME_MODEL_ROOT=/home/lachlan/.local/share/lazying-game/current/models/chess
LoadCredential=game-gateway-upstream-token:/home/lachlan/.config/lazyedge-game/secrets/gateway-upstream
ExecStart=/usr/bin/node /home/lachlan/.local/share/lazying-game/current/apps/gateway/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillMode=control-group
MemoryHigh=1G
MemoryMax=2G
CPUQuota=200%
TasksMax=128
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
